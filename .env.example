# Copy this file to .env and fill it in:  cp .env.example .env
#
# Keep the single quotes around the password hash. A bcrypt hash contains "$",
# and quoting stops docker compose from trying to expand it.

# --- required -----------------------------------------------------------

ADMIN_USER=me

# Generate with:  npm run hash-password -- 'your password'
# No local node?  docker compose run --rm iou node scripts/hash-password.js 'your password'
ADMIN_PASSWORD_HASH='$2b$12$replace.this.with.a.real.bcrypt.hash.000000000000000000'

# --- optional -----------------------------------------------------------

# Leave blank and a random secret is written to /data/session_secret on first
# run and reused after that. Setting it explicitly means sessions survive even
# if the volume is wiped. Any long random string works.
SESSION_SECRET=

# Payment links on the share page. Omit one and its button simply does not
# appear. Handles only; a full profile URL is also accepted and trimmed down.
VENMO_HANDLE=
PAYPAL_ME=
CASHAPP_HANDLE=

# Shown in the admin header, and on the share page as "you owe to <OWNER_NAME>".
SITE_TITLE=IOU
OWNER_NAME=

# The address people actually use, e.g. https://iou.example.com. Share links
# are built from the incoming request unless this is set; set it if your
# reverse proxy rewrites the Host header.
PUBLIC_BASE_URL=

# Timestamps are stored in UTC and displayed in this zone.
TZ=America/Denver
